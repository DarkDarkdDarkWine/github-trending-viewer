{
  "name": "github-trending-viewer",
  "version": "1.0.0",
  "description": "A beautiful GitHub trending viewer with Chinese UI, star tracking, ranking changes, AI translation, and personal starred repository activity monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint server.js src/ ai-provider.js analyzer.js summarizer.js scheduler.js github-client.js db.js scripts/",
    "test": "jest --verbose --forceExit",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "migrate:ranking": "node scripts/migrate-ranking-history.js",
    "migrate:encrypt-keys": "node scripts/encrypt-ai-keys.js"
  },
  "keywords": [
    "github",
    "trending",
    "viewer",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
