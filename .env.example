# GitHub Personal Access Token
# 创建方法：https://github.com/settings/tokens
# 需要权限：public_repo 或 user
GITHUB_TOKEN=your_github_token_here

# PostgreSQL 连接（可选，不配置则跳过数据库写入）
DATABASE_URL=postgresql://user:password@host:5433/github_trending

# AI Provider Key 加密密钥（32 字节 base64）
# 生成: npm run gen-key
ENCRYPTION_KEY=

# AI API Key（可在页面 AI 设置 中配置，也可在此处预设）
# DEEPSEEK_API_KEY=your_deepseek_key_here
# ZHIPU_API_KEY=your_zhipu_key_here
